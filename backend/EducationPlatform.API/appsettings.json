{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=EducationPlatform;Username=postgres;Password=password"
  },
  "JwtSettings": {
    "SecretKey": "YourSuperSecretKeyThatShouldBeAtLeast32CharactersLong!",
    "Issuer": "EducationPlatform",
    "Audience": "EducationPlatform",
    "ExpirationMinutes": 1440
  },
  "FileStorage": {
    "VideoPath": "wwwroot/videos",
    "PdfPath": "wwwroot/pdfs",
    "MaxVideoSize": 1073741824,
    "MaxPdfSize": 10485760
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  },
  "DrmSettings": {
    "WidevineLicenseServer": "https://license-server-url",
    "FairPlayLicenseServer": "https://fairplay-license-server-url",
    "CertificateUrl": "https://certificate-url",
    "KeyId": "key-id"
  },
  "WatermarkSettings": {
    "Enabled": true,
    "ClientSideOverlay": true,
    "ServerSideEmbedding": true,
    "Opacity": 0.3,
    "UpdateInterval": 5000
  },
  "SecuritySettings": {
    "ViolationLogging": true,
    "AutoBlockOnViolations": false,
    "MaxViolationsBeforeBlock": 3
  },
  "VideoProcessing": {
    "FfmpegPath": "ffmpeg",
    "EnableHls": true,
    "EnableDash": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}